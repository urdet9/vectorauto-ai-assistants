# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не публикуйте и не отправляйте никому — в нём секретный ключ.

OPENAI_API_KEY=sk-your-key-here

# Модель: укажите ту, что доступна в вашем аккаунте OpenAI (или у прокси-сервиса).
OPENAI_MODEL=gpt-4o-mini

# Необязательно: адрес прокси-сервиса, совместимого с OpenAI API.
# Оставьте пустым, если подключаетесь к OpenAI напрямую.
OPENAI_BASE_URL=

# Креативность ответов (0 — строго, 1 — свободно). Для ассистентов поддержки 0.3–0.5.
TEMPERATURE=0.4

# Сколько последних сообщений диалога отправлять модели.
MAX_HISTORY_MESSAGES=20

# --- Отправка заявок в Telegram (необязательно) ---
# Токен бота от @BotFather. Если пусто — заявки только сохраняются в data/handoffs.jsonl.
TELEGRAM_BOT_TOKEN=
# id чатов отделов (узнать: python telegram_setup.py). Для групп id начинается с минуса.
TELEGRAM_CHAT_SALES=
TELEGRAM_CHAT_SERVICE=
TELEGRAM_CHAT_HR=
# Чат для отделов, у которых свой чат не указан (например, один общий чат для демо).
TELEGRAM_CHAT_DEFAULT=
